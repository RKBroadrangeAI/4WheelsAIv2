# LangChain + Jev Web Application Configuration
# Copy this file to .env and fill in your API keys

# TypeSafe AI (Jev) - Direct API access
# Get your API key from https://typesafe.ai
TYPESAFE_API_KEY=

# OpenRouter - Alternative for Jev access
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=

# OpenAI - For LangChain text generation
# Get your API key from https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application Settings
DEBUG=true
